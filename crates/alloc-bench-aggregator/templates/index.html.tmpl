<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<!-- WR-04 (Phase-04 review): defense-in-depth CSP. The inline RESULTS
     <script> block requires 'unsafe-inline'; the only external script is
     the pinned Plotly CDN tag below, which is also pinned via SRI
     integrity= + crossorigin=anonymous. Any *other* external script
     injection would be blocked by script-src. style-src allows
     'unsafe-inline' because the <style> block in this <head> ships
     CSS variables for the Viridis palette; img-src allows data: so
     Plotly's PNG export modebar button works. -->
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plot.ly; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<title>alloc-bench report — {run_count} runs, {timestamp_iso8601}</title>
<!-- plotly: 2.35.3 · {plotly_sri_hash} (computed 2026-05-19 against cdn.plot.ly) -->
<script
  src="{plotly_cdn_url}"
  integrity="{plotly_sri_hash}"
  crossorigin="anonymous"></script>
<style>
:root \{
  /* Chrome (60/30/10) */
  --color-dominant: #FFFFFF;
  --color-secondary: #F4F5F7;
  --color-border: #E1E4E8;
  --color-text: #1F2328;
  --color-text-muted: #656D76;
  --color-accent: #0969DA;
  --color-destructive: #CF222E;

  /* Winner highlight (semantic, not in 60/30/10 budget) */
  --color-winner-bg: #DAFBE1;
  --color-winner-text: #1A7F37;

  /* Allocator series (Viridis-derived) */
  --color-series-ptmalloc: #440154;
  --color-series-mallocng: #3B528B;
  --color-series-jemalloc: #21908C;
  --color-series-mimalloc: #5DC863;

  /* Spacing */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;

  /* Typography */
  --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
               "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --font-size-body: 14px;
  --font-size-heading: 20px;
  --font-size-display: 28px;
  --font-weight-regular: 400;
  --font-weight-semibold: 600;
}
body \{
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-regular);
  line-height: 1.5;
  color: var(--color-text);
  background: var(--color-dominant);
}
.page \{
  max-width: 1440px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 220px 1fr;
}
header \{
  grid-column: 1 / -1;
  padding: var(--space-xl) var(--space-lg) var(--space-md);
}
header h1 \{
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-semibold);
  line-height: 1.2;
  margin: 0 0 var(--space-xs) 0;
}
header p \{
  margin: 0;
  color: var(--color-text-muted);
}
aside.sidebar \{
  width: 220px;
  background: var(--color-secondary);
  padding: var(--space-lg);
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  box-sizing: border-box;
}
aside.sidebar section \{
  margin-bottom: var(--space-md);
}
aside.sidebar strong \{
  display: block;
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--space-xs);
}
aside.sidebar select \{
  width: 100%;
  padding: var(--space-sm);
  font-family: var(--font-body);
  font-size: var(--font-size-body);
}
aside.sidebar select:focus option:checked \{
  outline: 2px solid var(--color-accent);
  outline-offset: 1px;
}
aside.sidebar p.hint \{
  color: var(--color-text-muted);
  font-size: 12px;
  margin: var(--space-md) 0 0 0;
}
main.charts \{
  padding: var(--space-lg);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg);
}
.chart-card \{
  background: var(--color-dominant);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: var(--space-md);
  min-height: 480px;
}
section.diff-picker \{
  grid-column: 2 / -1;
  padding: var(--space-md) var(--space-lg) var(--space-xl);
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  gap: var(--space-md);
  align-items: center;
}
section.diff-picker label \{
  font-weight: var(--font-weight-semibold);
}
@media (max-width: 768px) \{
  .page \{
    grid-template-columns: 1fr;
  }
  aside.sidebar \{
    position: relative;
    height: auto;
    width: 100%;
  }
  main.charts \{
    grid-template-columns: 1fr;
  }
}
@media print \{
  aside.sidebar \{
    display: none;
  }
  main.charts \{
    grid-template-columns: 1fr 1fr;
  }
}
/* Plan 03 Task 4: per-scenario allocator report-mirror table.
   Mirrors REPORT.md's bold-and-✓ winner contract via CSS variables
   --color-winner-bg / --color-winner-text declared in :root. */
.report-mirror \{
  grid-column: 2 / -1;
  margin: var(--space-2xl) var(--space-lg) var(--space-xl);
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background: var(--color-dominant);
}
.report-mirror h2 \{
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-semibold);
  margin: 0 0 var(--space-md) 0;
}
.report-mirror h3 \{
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  margin: var(--space-md) 0 var(--space-sm) 0;
}
.report-mirror table \{
  border-collapse: collapse;
  width: 100%;
  margin-bottom: var(--space-md);
}
.report-mirror th, .report-mirror td \{
  border: 1px solid var(--color-border);
  padding: var(--space-sm);
  text-align: left;
  font-size: var(--font-size-body);
}
.report-mirror th \{
  background: var(--color-secondary);
  font-weight: var(--font-weight-semibold);
}
.report-mirror tr.winner \{
  background: var(--color-winner-bg);
  color: var(--color-winner-text);
}
.report-mirror tr.winner td:first-child \{
  font-weight: var(--font-weight-semibold);
}
.report-mirror .suspect-note \{
  color: var(--color-destructive);
  font-style: italic;
  margin-left: var(--space-xs);
}
</style>
</head>
<body>
<div class="page">
  <header>
    <h1>alloc-bench report</h1>
    <p>{run_count} runs across {cell_count} cells · generated {timestamp_iso8601}</p>
  </header>
  <aside class="sidebar">
    <section>
      <strong>Scenarios</strong>
      <select id="sel-scenarios" multiple size="6"></select>
    </section>
    <section>
      <strong>Environments</strong>
      <select id="sel-envs" multiple size="6"></select>
    </section>
    <section>
      <strong>Allocators</strong>
      <select id="sel-allocs" multiple size="6"></select>
    </section>
    <p class="hint">Hold Cmd or Ctrl to multi-select. Charts update live.</p>
  </aside>
  <main class="charts">
    <div id="chart-throughput" class="chart-card"></div>
    <div id="chart-latency" class="chart-card"></div>
    <div id="chart-rss" class="chart-card"></div>
    <div id="chart-diff" class="chart-card"></div>
  </main>
  <section class="diff-picker">
    <label>Config A</label>
    <select id="ab-a-alloc"></select>
    <select id="ab-a-env"></select>
    <label>Config B</label>
    <select id="ab-b-alloc"></select>
    <select id="ab-b-env"></select>
    <div id="diff-banner" style="grid-column: 1 / -1; display:none; color: var(--color-destructive); margin-top: var(--space-sm);"></div>
  </section>
  <section class="report-mirror">
    <h2>Per-scenario allocator comparison</h2>
    <div id="report-mirror-tables"></div>
  </section>
</div>
<script>
// Inlined results — `unescaped` formatter prevents tinytemplate from
// HTML-escaping `<`/`>`/`&`/`"` inside the JSON.
const RESULTS = { results_json | unescaped };

// Plan 02 (Task 1) — sidebar bootstrap source data. Server-side BTreeSet
// guarantees alphabetical iteration order (D-09 byte-identical output).
const SCENARIOS = { scenarios_json | unescaped };
const ENVS = { envs_json | unescaped };
const ALLOCATORS = { allocators_json | unescaped };
// `\{allocator}·\{env}` keys for runs that trip the D-07 suspect predicate
// (samples_count<10000 OR warmup_duration_s<5.0). Wrapped in a Set so the
// bootstrap can decide per-option whether to render the `⚠ ` prefix.
const SUSPECT_PAIRS = new Set({ suspect_pairs_json | unescaped });

// Plan 03 D-11 / D-12 — multi-run statistics keyed by `\{alloc}|\{env}|\{scenario}`.
// Server-side BTreeMap keyed by 3-tuple → alphabetical-iteration JSON,
// flattened to the `alloc|env|scenario` string for O(1) JS lookup.
// Each value is a `\{ n, mean, median, min, max, stddev, cv_pct }` shape.
// Empty `\{}` when no `(alloc, env, scenario)` triple has ≥2 runs (single-
// run-per-cell fallback path emits no error_y whiskers + no ⚠ flag).
const MULTI_RUN_GROUPED = { multi_run_grouped_json | unescaped };

function envLabel(run) \{ return run.env.docker_image || 'host'; }
function isSuspect(run) \{ return run.harness.samples_count < 10000 || run.harness.warmup_duration_s < 5.0; }
// `·` keeps the file pure ASCII — equivalent to U+00B7 MIDDLE DOT
// at runtime, which matches the SUSPECT_PAIRS keys emitted by html.rs.
function suspectKey(alloc, env) \{ return alloc + '·' + env; }

function bootstrap() \{
  // Multi-selects: every option starts `selected` per UI-SPEC line 240.
  const multiTargets = [
    \{ id: 'sel-scenarios', src: SCENARIOS },
    \{ id: 'sel-envs', src: ENVS },
    \{ id: 'sel-allocs', src: ALLOCATORS },
  ];
  for (const t of multiTargets) \{
    const sel = document.querySelector('#' + t.id);
    sel.innerHTML = '';
    for (const v of t.src) \{
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      opt.selected = true;
      sel.appendChild(opt);
    }
  }
  // A/B picker single-selects. `⚠ ` prefix surfaces server-side via
  // SUSPECT_PAIRS (UI-SPEC line 128).
  const allocPickers = ['ab-a-alloc', 'ab-b-alloc'];
  const envPickers = ['ab-a-env', 'ab-b-env'];
  for (const id of allocPickers) \{
    const sel = document.querySelector('#' + id);
    sel.innerHTML = '';
    for (const a of ALLOCATORS) \{
      // Any env paired with this alloc that is suspect → prefix.
      let any = false;
      for (const e of ENVS) \{
        if (SUSPECT_PAIRS.has(suspectKey(a, e))) \{ any = true; break; }
      }
      const opt = document.createElement('option');
      opt.value = a;
      opt.textContent = (any ? '⚠ ' : '') + a;
      sel.appendChild(opt);
    }
  }
  for (const id of envPickers) \{
    const sel = document.querySelector('#' + id);
    sel.innerHTML = '';
    for (const e of ENVS) \{
      let any = false;
      for (const a of ALLOCATORS) \{
        if (SUSPECT_PAIRS.has(suspectKey(a, e))) \{ any = true; break; }
      }
      const opt = document.createElement('option');
      opt.value = e;
      opt.textContent = (any ? '⚠ ' : '') + e;
      sel.appendChild(opt);
    }
  }
  // Defaults per UI-SPEC line 256: A=(first alloc, first env);
  // B=(second alloc if available else first, same env as A).
  if (ALLOCATORS.length > 0 && ENVS.length > 0) \{
    document.querySelector('#ab-a-alloc').value = ALLOCATORS[0];
    document.querySelector('#ab-a-env').value = ENVS[0];
    document.querySelector('#ab-b-alloc').value = ALLOCATORS.length > 1 ? ALLOCATORS[1] : ALLOCATORS[0];
    document.querySelector('#ab-b-env').value = ENVS[0];
  }
}

// --- Plan 02 Task 2: chart trace builders + filter handler + A/B diff -----

// Viridis allocator color map (UI-SPEC line 92). Colorblind-safe;
// deterministic legend ordering across runs.
const ALLOC_COLORS = \{
  ptmalloc: '#440154',
  mallocng: '#3B528B',
  jemalloc: '#21908C',
  mimalloc: '#5DC863',
};

// UI-SPEC line 291: hide the modebar by default; reveal on hover; drop
// Plotly's logo and the cloud-export button (privacy + screenshot tidiness).
const PLOTLY_CONFIG = \{
  displayModeBar: 'hover',
  displaylogo: false,
  modeBarButtonsToRemove: ['sendDataToCloud', 'lasso2d', 'select2d'],
  modeBarPosition: 'bottom',
};

// UI-SPEC line 291 / Print and Screenshot Friendliness: override Plotly's
// Open Sans default with the system stack — no webfont fetch, identical
// pixels across reviewer machines.
const SHARED_FONT = \{
  family: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
};

// --- helpers ---

function readSelections() \{
  return \{
    scenarios: Array.from(document.querySelector('#sel-scenarios').selectedOptions).map(o => o.value),
    envs:      Array.from(document.querySelector('#sel-envs').selectedOptions).map(o => o.value),
    allocs:    Array.from(document.querySelector('#sel-allocs').selectedOptions).map(o => o.value),
  };
}

function applyFilters(runs, sel) \{
  return runs.filter(r =>
    sel.scenarios.includes(r.scenario.name) &&
    sel.envs.includes(envLabel(r)) &&
    sel.allocs.includes(r.build.allocator)
  );
}

function isEmptySelection(sel) \{
  return sel.scenarios.length === 0 || sel.envs.length === 0 || sel.allocs.length === 0;
}

function setEmptyState(divIds) \{
  for (const id of divIds) \{
    const card = document.querySelector('#' + id);
    if (card) \{
      card.innerHTML = '<h3>No data in current filter</h3><p>Select at least one scenario, environment, and allocator to render charts.</p>';
    }
  }
}

function legendName(run) \{
  const env = envLabel(run);
  const prefix = SUSPECT_PAIRS.has(suspectKey(run.build.allocator, env)) ? '⚠ ' : '';
  return prefix + run.build.allocator + '·' + env;
}

// Sorted, de-duplicated string list for chart axes/series.
function uniqSorted(items) \{
  return Array.from(new Set(items)).sort();
}

// --- Chart 1: throughput grouped bar ---
//
// SCOPE NOTE: D-04 calls for "faceted by env" but UI-SPEC §Layout shows
// ONE bar chart cell, not a multi-panel facet. Plan 02 ships a single
// grouped bar (one bar per allocator across all envs in scope, scenario
// on X). True env-faceting via Plotly subplots remains a v2 stretch;
// RESEARCH §Code Examples §3 covers the pattern when needed.
function makeThroughputTraces(filtered) \{
  const allocs = uniqSorted(filtered.map(r => r.build.allocator));
  const scenarios = uniqSorted(filtered.map(r => r.scenario.name));
  const traces = [];
  for (const alloc of allocs) \{
    const allocRuns = filtered.filter(r => r.build.allocator === alloc);
    let anySuspect = false;
    for (const r of allocRuns) \{
      if (isSuspect(r)) \{ anySuspect = true; break; }
    }
    // D-11 / D-12 (Plan 03 Task 4): when MULTI_RUN_GROUPED has the cell,
    // use median for y and asymmetric error_y from min/max; otherwise
    // fall back to the single-run ticks_per_s (Phase-4 contract). Build
    // the y / yMinus / yPlus arrays scenario-by-scenario.
    const yMedians = [];
    const yMinus = [];
    const yPlus = [];
    let anyHighVariance = false;
    for (const s of scenarios) \{
      const hit = allocRuns.find(r => r.scenario.name === s);
      if (!hit) \{
        yMedians.push(null);
        yMinus.push(0);
        yPlus.push(0);
        continue;
      }
      const key = hit.build.allocator + '|' + envLabel(hit) + '|' + hit.scenario.name;
      const mr = MULTI_RUN_GROUPED[key];
      if (mr) \{
        yMedians.push(mr.median);
        yMinus.push(mr.median - mr.min);
        yPlus.push(mr.max - mr.median);
        if (mr.cv_pct !== null && mr.cv_pct !== undefined && mr.cv_pct > 10) \{
          anyHighVariance = true;
        }
      } else \{
        yMedians.push(hit.metrics.ticks_per_s);
        yMinus.push(0);
        yPlus.push(0);
      }
    }
    const legendName = alloc
      + (anySuspect ? ' ⚠ suspect' : '')
      + (anyHighVariance ? ' ⚠ high variance' : '');
    // WR-05 (Phase-5 review): single-run cells push 0 to yMinus/yPlus.
    // Plotly renders zero-length error bars as small ticks on the bar's
    // centerline, so mixed dashboards (some cells multi-run, some not)
    // showed inconsistent appearance. Gate `visible` on whether any
    // error-bar value is non-zero so single-run cells render flat bars.
    const hasErrorBars = yPlus.some(v => v > 0) || yMinus.some(v => v > 0);
    traces.push(\{
      type: 'bar',
      name: legendName,
      x: scenarios,
      y: yMedians,
      error_y: \{
        type: 'data',
        symmetric: false,
        array: yPlus,
        arrayminus: yMinus,
        visible: hasErrorBars,
        color: '#1F2328',
        thickness: 1.0,
        width: 4,
      },
      marker: \{ color: ALLOC_COLORS[alloc] || '#888' },
    });
  }
  return traces;
}

const throughputLayout = \{
  barmode: 'group',
  font: SHARED_FONT,
  yaxis: \{ title: \{ text: 'throughput (per scenario unit, see scenario.unit)' } },
  xaxis: \{ title: \{ text: 'scenario' } },
  margin: \{ t: 80, r: 16, b: 64, l: 80 },
  title: \{ text: 'Throughput by scenario' },
};

// --- Chart 2: latency-percentile heatmap ---
function makeLatencyHeatmap(filtered) \{
  const sorted = filtered.slice().sort((a, b) => \{
    const ka = a.build.allocator + '|' + envLabel(a) + '|' + a.scenario.name;
    const kb = b.build.allocator + '|' + envLabel(b) + '|' + b.scenario.name;
    return ka < kb ? -1 : ka > kb ? 1 : 0;
  });
  const y = sorted.map(r => legendName(r) + '·' + r.scenario.name);
  const x = ['p50', 'p95', 'p99', 'p999', 'max'];
  const z = sorted.map(r => [
    r.metrics.tick_latency_ns.p50,
    r.metrics.tick_latency_ns.p95,
    r.metrics.tick_latency_ns.p99,
    r.metrics.tick_latency_ns.p999,
    r.metrics.tick_latency_ns.max,
  ]);
  return [\{
    type: 'heatmap',
    z: z,
    x: x,
    y: y,
    colorscale: 'Viridis',
    reversescale: false,
    colorbar: \{ title: \{ text: 'latency (ns)' } },
  }];
}

const latencyLayout = \{
  font: SHARED_FONT,
  margin: \{ t: 80, r: 16, b: 32, l: 360 },
  yaxis: \{ tickfont: \{ size: 10 } },
  title: \{ text: 'Latency percentiles (heatmap)' },
};

// --- Chart 3: RSS over time ---
//
// 260523-8jf Task 2: cap series count to the cells nominated by the A/B
// picker. The user already chose those two cells as "interesting" via
// `readAbSelections()`, so reusing the existing UI element avoids adding
// a new control. When A==B (degenerate config) we fall back to the first
// 12 cells alphabetically so the chart stays useful before the user has
// differentiated A from B.
function makeRssLines(filtered) \{
  const ab = readAbSelections();
  const aKey = ab.a.alloc + '|' + ab.a.env;
  const bKey = ab.b.alloc + '|' + ab.b.env;
  const sameCell = aKey === bKey;
  let candidates;
  if (sameCell) \{
    // Degenerate A==B → fall back to first 12 cells alphabetically.
    const seen = new Set();
    const ordered = filtered.slice().sort((a, b) => \{
      const ka = a.build.allocator + '|' + envLabel(a) + '|' + a.scenario.name;
      const kb = b.build.allocator + '|' + envLabel(b) + '|' + b.scenario.name;
      return ka < kb ? -1 : ka > kb ? 1 : 0;
    });
    candidates = [];
    for (const r of ordered) \{
      const k = r.build.allocator + '|' + envLabel(r);
      if (!seen.has(k) && seen.size < 12) \{
        seen.add(k);
      }
      if (seen.has(k)) \{
        candidates.push(r);
      }
    }
  } else \{
    candidates = filtered.filter(r => \{
      const k = r.build.allocator + '|' + envLabel(r);
      return k === aKey || k === bKey;
    });
  }
  const sorted = candidates.slice().sort((a, b) => \{
    const ka = a.build.allocator + '|' + envLabel(a) + '|' + a.scenario.name;
    const kb = b.build.allocator + '|' + envLabel(b) + '|' + b.scenario.name;
    return ka < kb ? -1 : ka > kb ? 1 : 0;
  });
  const traces = [];
  for (const r of sorted) \{
    const samples = r.metrics.rss_growth_samples || [];
    if (samples.length === 0) \{ continue; }
    traces.push(\{
      type: 'scatter',
      mode: 'lines',
      name: legendName(r) + '·' + r.scenario.name,
      x: samples.map(s => s.t_s),
      y: samples.map(s => s.rss_kb),
      line: \{ color: ALLOC_COLORS[r.build.allocator] || '#888' },
    });
  }
  return traces;
}

const rssLayout = \{
  font: SHARED_FONT,
  yaxis: \{ title: \{ text: 'RSS (kB)' } },
  xaxis: \{ title: \{ text: 'elapsed (s)' } },
  margin: \{ t: 80, r: 16, b: 48, l: 80 },
  title: \{ text: 'RSS over time<br><sub>showing the two cells selected in the A/B picker below</sub>' },
};

// --- Chart 4: A/B comparison-diff ---

function readAbSelections() \{
  return \{
    a: \{
      alloc: document.querySelector('#ab-a-alloc').value,
      env:   document.querySelector('#ab-a-env').value,
    },
    b: \{
      alloc: document.querySelector('#ab-b-alloc').value,
      env:   document.querySelector('#ab-b-env').value,
    },
  };
}

// Find the first run matching alloc+env. When multiple scenarios are
// present, prefer the Phase-1 anchor scenario `multithread` (D-04).
function findCellRun(filtered, alloc, env) \{
  const matches = filtered.filter(r => r.build.allocator === alloc && envLabel(r) === env);
  if (matches.length === 0) \{ return null; }
  const mt = matches.find(r => r.scenario.name === 'multithread');
  return mt || matches[0];
}

function pctDelta(a, b) \{
  if (a === 0) \{ return 0; }
  return ((b - a) / a) * 100;
}

function makeDiffBars(filtered) \{
  const ab = readAbSelections();
  const aRun = findCellRun(filtered, ab.a.alloc, ab.a.env);
  const bRun = findCellRun(filtered, ab.b.alloc, ab.b.env);
  const labels = ['throughput', 'p99 latency', 'peak RSS'];
  if (!aRun || !bRun) \{
    return [\{
      type: 'bar',
      x: labels,
      y: [0, 0, 0],
      marker: \{ color: '#888' },
    }];
  }
  const ys = [
    pctDelta(aRun.metrics.ticks_per_s, bRun.metrics.ticks_per_s),
    pctDelta(aRun.metrics.tick_latency_ns.p99, bRun.metrics.tick_latency_ns.p99),
    pctDelta(aRun.metrics.peak_rss_kb, bRun.metrics.peak_rss_kb),
  ];
  return [\{
    type: 'bar',
    x: labels,
    y: ys,
    marker: \{ color: ys.map(v => v >= 0 ? '#1A7F37' : '#CF222E') },
    text: ys.map(v => (v >= 0 ? '+' : '') + v.toFixed(1) + '%'),
    textposition: 'outside',
  }];
}

const diffLayout = \{
  font: SHARED_FONT,
  yaxis: \{ title: \{ text: '% delta (B vs A)' } },
  margin: \{ t: 80, r: 16, b: 72, l: 80 },
  title: \{ text: 'A/B comparison' },
  shapes: [\{
    type: 'line',
    x0: -0.5,
    x1: 2.5,
    y0: 0,
    y1: 0,
    line: \{ color: '#888', width: 1, dash: 'dot' },
  }],
};

function maybeDiffBanner(filtered) \{
  const banner = document.querySelector('#diff-banner');
  if (!banner) \{ return; }
  const ab = readAbSelections();
  let msg = '';
  if (ab.a.alloc === ab.b.alloc && ab.a.env === ab.b.env) \{
    msg = 'Config A and Config B are identical — pick differing values to see a delta.';
  } else \{
    const aRun = findCellRun(filtered, ab.a.alloc, ab.a.env);
    const bRun = findCellRun(filtered, ab.b.alloc, ab.b.env);
    const aSus = aRun && isSuspect(aRun);
    const bSus = bRun && isSuspect(bRun);
    if (aSus || bSus) \{
      msg = '⚠ One or both selected configs are flagged suspect.';
    }
  }
  banner.textContent = msg;
  banner.style.display = msg ? 'block' : 'none';
}

// --- main handlers ---

function onFilterChange() \{
  const sel = readSelections();
  if (isEmptySelection(sel)) \{
    setEmptyState(['chart-throughput', 'chart-latency', 'chart-rss', 'chart-diff']);
    maybeDiffBanner([]);
    return;
  }
  const filtered = applyFilters(RESULTS, sel);
  // RESEARCH §Anti-Patterns: always use Plotly.react for re-renders — it
  // diffs and updates in place; the alternative API re-mounts and flickers.
  Plotly.react('chart-throughput', makeThroughputTraces(filtered), throughputLayout, PLOTLY_CONFIG);
  Plotly.react('chart-latency',    makeLatencyHeatmap(filtered),  latencyLayout,    PLOTLY_CONFIG);
  Plotly.react('chart-rss',        makeRssLines(filtered),        rssLayout,        PLOTLY_CONFIG);
  Plotly.react('chart-diff',       makeDiffBars(filtered),        diffLayout,       PLOTLY_CONFIG);
  maybeDiffBanner(filtered);
}

// A/B picker change: the diff chart depends on A/B selections, but
// recomputing all four charts is cheap and keeps the handler set small.
function onAbChange() \{
  onFilterChange();
}

// --- Plan 03 Task 4: per-scenario report-mirror table ---
//
// Mirrors REPORT.md's bold-and-✓ winner contract in HTML. The table is a
// static representation of ALL runs (not filtered by the sidebar) so the
// HTML view stays consistent with the markdown report. DOM construction
// uses textContent + document.createElement throughout — no innerHTML
// concatenation with user data — so a Run with `<script>` in its
// allocator name (already validated by serde, but defensive) cannot
// inject anywhere on the page.
function renderReportMirrorTable() \{
  const root = document.querySelector('#report-mirror-tables');
  if (!root) \{ return; }
  // Clear any prior content (idempotent re-render is safe).
  while (root.firstChild) \{ root.removeChild(root.firstChild); }

  // Group RESULTS by scenario name; alphabetical iteration via sort().
  // WR-03 (Phase-04 review): use `Object.create(null)` so a scenario
  // name like `__proto__` / `constructor` / `hasOwnProperty` cannot
  // pollute the prototype chain. Aligns the JS side with the Rust
  // side's BTreeMap semantics (no inherited keys).
  const byScenario = Object.create(null);
  for (const r of RESULTS) \{
    const key = r.scenario.name;
    if (!byScenario[key]) \{ byScenario[key] = []; }
    byScenario[key].push(r);
  }
  const scenarioNames = Object.keys(byScenario).sort();

  for (const scenario of scenarioNames) \{
    const arr = byScenario[scenario];
    // Find winner: max ticks_per_s. Tie-break: alphabetical via
    // alloc·env ordering (matches REPORT.md's index-not-name approach).
    const sortedAlpha = arr.slice().sort((a, b) => \{
      const ka = a.build.allocator + '|' + envLabel(a);
      const kb = b.build.allocator + '|' + envLabel(b);
      return ka < kb ? -1 : ka > kb ? 1 : 0;
    });
    let winnerIdx = 0;
    for (let i = 1; i < sortedAlpha.length; i++) \{
      if (sortedAlpha[i].metrics.ticks_per_s > sortedAlpha[winnerIdx].metrics.ticks_per_s) \{
        winnerIdx = i;
      }
    }

    const heading = document.createElement('h3');
    heading.textContent = scenario;
    root.appendChild(heading);

    const table = document.createElement('table');
    const thead = document.createElement('thead');
    const headerRow = document.createElement('tr');
    for (const label of ['allocator', 'throughput', 'p50', 'p95', 'p99', 'p999', 'peak RSS']) \{
      const th = document.createElement('th');
      th.textContent = label;
      headerRow.appendChild(th);
    }
    thead.appendChild(headerRow);
    table.appendChild(thead);

    const tbody = document.createElement('tbody');
    for (let i = 0; i < sortedAlpha.length; i++) \{
      const r = sortedAlpha[i];
      const tr = document.createElement('tr');
      if (i === winnerIdx) \{ tr.className = 'winner'; }

      // Allocator cell — ✓ U+2713 prefix on the winner; matches
      // REPORT.md's bold-and-✓-prefix contract.
      const tdAlloc = document.createElement('td');
      tdAlloc.textContent = (i === winnerIdx ? '\u\{2713} ' : '') + r.build.allocator;
      tr.appendChild(tdAlloc);

      // Throughput cell — value + optional <span class="suspect-note">.
      const tdTput = document.createElement('td');
      const unit = (r.scenario.unit || 'ticks/s');
      tdTput.textContent = r.metrics.ticks_per_s.toFixed(1) + ' ' + unit;
      const low = r.harness.samples_count < 10000;
      const short = r.harness.warmup_duration_s < 5.0;
      if (low || short) \{
        const note = document.createElement('span');
        note.className = 'suspect-note';
        let reason;
        if (low && short) \{ reason = '\u\{26A0} low samples, short warmup'; }
        else if (low) \{ reason = '\u\{26A0} low samples'; }
        else \{ reason = '\u\{26A0} short warmup'; }
        note.textContent = reason;
        tdTput.appendChild(note);
      }
      tr.appendChild(tdTput);

      for (const v of [
        r.metrics.tick_latency_ns.p50,
        r.metrics.tick_latency_ns.p95,
        r.metrics.tick_latency_ns.p99,
        r.metrics.tick_latency_ns.p999,
      ]) \{
        const td = document.createElement('td');
        td.textContent = v + ' ns';
        tr.appendChild(td);
      }
      const tdRss = document.createElement('td');
      tdRss.textContent = r.metrics.peak_rss_kb + ' kB';
      tr.appendChild(tdRss);

      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
    root.appendChild(table);
  }
}

// --- wire up listeners ---

document.querySelectorAll('select[multiple]').forEach(el => \{
  el.addEventListener('change', onFilterChange);
});
['ab-a-alloc', 'ab-a-env', 'ab-b-alloc', 'ab-b-env'].forEach(id => \{
  document.querySelector('#' + id).addEventListener('change', onAbChange);
});

bootstrap();
onFilterChange();
renderReportMirrorTable();
</script>
</body>
</html>
